---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
	src: string;
	alt: string;
	/** Falls back to a labelled placeholder when the file isn't in src/assets yet. */
	label?: string;
	class?: string;
	loading?: 'lazy' | 'eager';
	tone?: 'dark' | 'light';
	/** Widths to emit in the srcset. Omit both and a single image is emitted. */
	widths?: number[];
	/** Required alongside `widths` — the slot's real CSS width. */
	sizes?: string;
}

const {
	src,
	alt,
	label,
	class: className,
	loading = 'lazy',
	tone = 'dark',
	widths,
	sizes,
} = Astro.props;

const entry = resolveImage(src);
const caption = label ?? alt;

/* Astro requires the pair together, so only spread them when both are given.
   `width` pins the no-srcset fallback to the largest variant — without it
   Astro emits the full-size original as `src`, which every modern browser
   ignores in favour of the srcset but which still ships in the bundle. */
const responsive = widths && sizes ? { widths, sizes, width: Math.max(...widths) } : {};
---

{
	entry ? (
		<Image
			class:list={['media', className]}
			src={entry}
			alt={alt}
			loading={loading}
			decoding="async"
			{...responsive}
		/>
	) : (
		<div class:list={['media', 'media--empty', `media--${tone}`, className]} role="img" aria-label={alt}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
				<rect x="3" y="4" width="18" height="16" rx="2.5" />
				<circle cx="8.75" cy="9.75" r="1.6" />
				<path d="m4 17 4.5-4.5 3.5 3.5 3-3L20 17" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			<span>{caption}</span>
		</div>
	)
}

<style>
	.media {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: inherit;
	}

	.media--empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 16px;
		text-align: center;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	.media--empty svg {
		width: 26px;
		height: 26px;
		opacity: 0.55;
		flex: none;
	}

	.media--empty span {
		max-width: 26ch;
		opacity: 0.62;
	}

	.media--dark {
		color: #f2f2f7;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02)),
			repeating-linear-gradient(
				45deg,
				rgba(255, 255, 255, 0.035) 0 8px,
				transparent 8px 16px
			);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
	}

	.media--light {
		color: #141414;
		background:
			linear-gradient(135deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.015)),
			repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.03) 0 8px, transparent 8px 16px);
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
	}

	/* Tight slots (thumbnails) hide the caption so the glyph stays legible. */
	.media--empty:where(.is-thumb) span {
		display: none;
	}
</style>
