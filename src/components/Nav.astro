---
import { navItems } from '../data/content';
---

<header class="nav" data-nav>
	<nav class="nav__pill" aria-label="Primary">
		<span class="nav__indicator" data-nav-indicator aria-hidden="true"></span>
		<ul class="nav__list">
			{
				navItems.map((item) => (
					<li>
						<a class="nav__link" href={item.href} data-nav-link data-target={item.href.slice(1)}>
							<span class="nav__index">{item.index}</span>
							<span class="nav__label">{item.label}</span>
						</a>
					</li>
				))
			}
		</ul>

		<button
			class="nav__burger"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="nav-drawer"
			aria-label="Open menu"
		>
			<span class="nav__burger-box" aria-hidden="true"><i /><i /><i /></span>
		</button>
	</nav>
</header>

{/* Siblings of the header on purpose: .nav is transformed until it drops in,
   and a transformed ancestor re-bases `position: fixed` descendants. */}
<div class="nav__scrim" data-nav-scrim aria-hidden="true"></div>

<aside id="nav-drawer" class="nav__drawer" data-nav-drawer>
	<ul class="nav__drawer-list">
		{
			navItems.map((item) => (
				<li>
					<a class="nav__drawer-link" href={item.href} data-nav-link data-target={item.href.slice(1)}>
						<span class="nav__drawer-index">{item.index}</span>
						<span class="nav__drawer-label">{item.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</aside>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		display: flex;
		justify-content: center;
		padding: 26px var(--gutter);
		pointer-events: none;
		/* Drops in once the page has painted */
		transform: translate3d(0, -140%, 0);
		opacity: 0;
		transition:
			transform 900ms var(--ease-out) 260ms,
			opacity 700ms ease 260ms;
	}

	.nav.is-ready {
		transform: none;
		opacity: 1;
	}

	.nav__pill {
		position: relative;
		pointer-events: auto;
		width: min(1109px, 100%);
		border-radius: 40px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: rgba(10, 10, 10, 0.4);
		backdrop-filter: blur(14px) saturate(140%);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		transition:
			background var(--dur) ease,
			border-color var(--dur) ease,
			box-shadow var(--dur) ease;
	}

	/* Once past the hero the bar sits on light surfaces — go opaque and darker. */
	.nav.is-scrolled .nav__pill {
		background: rgba(8, 8, 8, 0.82);
		border-color: rgba(255, 255, 255, 0.1);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
	}

	.nav__list {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 6px 10px;
	}

	.nav__link {
		position: relative;
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 8px 16px;
		border-radius: 30px;
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.62);
		white-space: nowrap;
		transition: color var(--dur-fast) ease;
	}

	.nav__link:hover,
	.nav__link.is-active {
		color: #ffffff;
	}

	.nav__index {
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
		color: var(--c-accent);
		opacity: 0;
		transform: translate3d(-4px, 0, 0);
		transition:
			opacity var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}

	.nav__link:hover .nav__index,
	.nav__link.is-active .nav__index {
		opacity: 1;
		transform: none;
	}

	.nav__label {
		position: relative;
	}

	/* Underline sweeps in from the left on hover. */
	.nav__label::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -3px;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--dur) var(--ease-out);
	}

	.nav__link:hover .nav__label::after {
		transform: scaleX(1);
	}

	/* The travelling highlight behind the active item. */
	.nav__indicator {
		position: absolute;
		top: 6px;
		left: 0;
		height: calc(100% - 12px);
		border-radius: 30px;
		background: rgba(255, 255, 255, 0.1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
		opacity: 0;
		transform: translate3d(var(--x, 0), 0, 0);
		width: var(--w, 0);
		transition:
			transform 620ms var(--ease-spring),
			width 620ms var(--ease-spring),
			opacity var(--dur-fast) ease;
		pointer-events: none;
	}

	.nav__indicator.is-on {
		opacity: 1;
	}

	/* ------------------------------------------------------------------ */
	/* Hamburger                                                           */
	/* ------------------------------------------------------------------ */

	.nav__burger {
		display: none;
	}

	.nav__burger-box {
		position: relative;
		display: block;
		width: 18px;
		height: 12px;
	}

	.nav__burger-box i {
		position: absolute;
		left: 0;
		width: 100%;
		height: 1.5px;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.92);
		transition:
			transform var(--dur) var(--ease-out),
			opacity var(--dur-fast) ease;
	}

	.nav__burger-box i:nth-child(1) {
		top: 0;
	}

	.nav__burger-box i:nth-child(2) {
		top: 50%;
		margin-top: -0.75px;
	}

	.nav__burger-box i:nth-child(3) {
		bottom: 0;
	}

	/* Outer bars meet in the middle and cross; the middle one drops out. */
	.nav__burger.is-open .nav__burger-box i:nth-child(1) {
		transform: translate3d(0, 5.25px, 0) rotate(45deg);
	}

	.nav__burger.is-open .nav__burger-box i:nth-child(2) {
		opacity: 0;
	}

	.nav__burger.is-open .nav__burger-box i:nth-child(3) {
		transform: translate3d(0, -5.25px, 0) rotate(-45deg);
	}

	/* ------------------------------------------------------------------ */
	/* Drawer + scrim                                                      */
	/* ------------------------------------------------------------------ */

	/* Plain dim, deliberately no backdrop-filter — a full-viewport blur here
	   would re-run on every hero repaint underneath it. */
	.nav__scrim {
		position: fixed;
		inset: 0;
		z-index: 98;
		display: none;
		background: rgba(0, 0, 0, 0.62);
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--dur) var(--ease-out);
	}

	.nav__scrim.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.nav__drawer {
		position: fixed;
		inset: 0 0 0 auto;
		z-index: 99;
		display: none;
		width: clamp(240px, 60vw, 360px);
		/* Clears the burger, which stays on top and doubles as the close button. */
		padding: 92px 0 32px;
		overflow-y: auto;
		overscroll-behavior: contain;
		background: rgba(10, 10, 10, 0.94);
		border-left: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: -20px 0 60px rgba(0, 0, 0, 0.5);
		transform: translate3d(100%, 0, 0);
		visibility: hidden;
		/* Visibility is held until the slide-out has finished. */
		transition:
			transform var(--dur) var(--ease-out),
			visibility 0s linear var(--dur);
	}

	.nav__drawer.is-open {
		transform: none;
		visibility: visible;
		transition:
			transform var(--dur) var(--ease-out),
			visibility 0s;
	}

	.nav__drawer-list {
		display: flex;
		flex-direction: column;
	}

	.nav__drawer-link {
		display: flex;
		align-items: baseline;
		gap: 12px;
		padding: 16px 24px 16px 22px;
		border-left: 2px solid transparent;
		font-size: 1.0625rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
		color: rgba(255, 255, 255, 0.62);
		transition:
			color var(--dur-fast) ease,
			border-color var(--dur-fast) ease,
			background var(--dur-fast) ease;
	}

	.nav__drawer-link.is-active {
		color: #ffffff;
		border-left-color: var(--c-accent);
		background: rgba(255, 255, 255, 0.05);
	}

	.nav__drawer-index {
		flex: none;
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
		color: rgba(255, 255, 255, 0.3);
		transition: color var(--dur-fast) ease;
	}

	.nav__drawer-link.is-active .nav__drawer-index {
		color: var(--c-accent);
	}

	/* ------------------------------------------------------------------ */
	/* Responsive                                                          */
	/* ------------------------------------------------------------------ */

	@media (max-width: 1040px) {
		.nav {
			padding: 16px var(--gutter);
			justify-content: flex-end;
		}

		/* Collapses to a circle around the burger — which also shrinks the
		   backdrop-filter the hero repaints under to a fraction of its area. */
		.nav__pill {
			width: auto;
			border-radius: 50%;
		}

		.nav__list,
		.nav__indicator {
			display: none;
		}

		.nav__burger {
			display: grid;
			place-items: center;
			width: 48px;
			height: 48px;
			border-radius: 50%;
		}

		.nav__scrim,
		.nav__drawer {
			display: block;
		}
	}

	/* global.css flattens the durations; without this the delayed visibility
	   would keep the drawer on screen for 420ms after it closes. */
	@media (prefers-reduced-motion: reduce) {
		.nav__drawer {
			transition-delay: 0s;
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>('[data-nav]');
	const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
	/* Every link, pill and drawer alike — they share the active state. */
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
	const pillLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__pill [data-nav-link]'));

	if (nav && indicator && links.length) {
		requestAnimationFrame(() => nav.classList.add('is-ready'));

		const moveIndicator = (link: HTMLAnchorElement | null) => {
			/* offsetParent is null while the pill list is display:none (mobile);
			   measuring then collapses the indicator to a zero-width sliver. */
			if (!link || link.offsetParent === null) {
				indicator.classList.remove('is-on');
				return;
			}
			indicator.style.setProperty('--x', `${link.offsetLeft}px`);
			indicator.style.setProperty('--w', `${link.offsetWidth}px`);
			indicator.classList.add('is-on');
		};

		const setActive = (id: string | null) => {
			for (const link of links) link.classList.toggle('is-active', link.dataset.target === id);
			moveIndicator(pillLinks.find((link) => link.dataset.target === id) ?? null);
		};

		/* Scrollspy: the section occupying the middle of the viewport wins. */
		const sections = pillLinks
			.map((link) => document.getElementById(link.dataset.target ?? ''))
			.filter((el): el is HTMLElement => Boolean(el));

		const spy = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) setActive(entry.target.id);
				}
			},
			{ rootMargin: '-45% 0px -50% 0px', threshold: 0 }
		);
		sections.forEach((section) => spy.observe(section));

		/* Solid backdrop once we leave the hero. */
		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > window.innerHeight * 0.6);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		window.addEventListener('resize', () => {
			moveIndicator(pillLinks.find((l) => l.classList.contains('is-active')) ?? null);
		});
	}

	/* --- Mobile drawer ------------------------------------------------- */

	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
	const scrim = document.querySelector<HTMLElement>('[data-nav-scrim]');

	if (toggle && drawer && scrim) {
		const desktop = window.matchMedia('(min-width: 1041px)');
		let open = false;

		const setOpen = (next: boolean) => {
			if (next === open) return;
			open = next;

			drawer.classList.toggle('is-open', open);
			scrim.classList.toggle('is-open', open);
			toggle.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			drawer.toggleAttribute('inert', !open);

			/* Same idiom as the lightbox: clearing the inline value hands
			   control back to global.css's `overflow-x: hidden`. */
			document.body.style.overflow = open ? 'hidden' : '';

			/* Deferred by a frame so the panel is past `visibility: hidden` —
			   focus() is a no-op on an element that is still invisible. */
			if (open) requestAnimationFrame(() => drawer.querySelector<HTMLAnchorElement>('a')?.focus());
			else toggle.focus();
		};

		drawer.toggleAttribute('inert', true);

		toggle.addEventListener('click', () => setOpen(!open));
		scrim.addEventListener('click', () => setOpen(false));

		/* No preventDefault — unlock the scroll first, then let the browser
		   run the hash navigation under global.css's smooth scrolling. */
		drawer.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		/* Crossing back to the pill must never strand the scroll lock. */
		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>
