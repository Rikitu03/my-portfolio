---
import { Image, getImage } from 'astro:assets';
import { resolveImages } from '../lib/images';
import Icon from './Icon.astro';

interface Props {
	/** Referenced by the `data-lb-open` triggers on the card. */
	id: string;
	name: string;
	/** Cover first, then every screenshot. */
	sources: string[];
}

const { id, name, sources } = Astro.props;
const images = resolveImages(sources);

/* One optimized preview per image, capped at 1600px — sharp on a large
   display without shipping the multi-megabyte originals. Dimensions travel
   with each frame so swapping the preview never shifts the layout. */
const frames = await Promise.all(
	images.map(async (img) => {
		const width = Math.min(img.width, 1600);
		const height = Math.round(img.height * (width / img.width));
		const built = await getImage({ src: img, width, height, format: 'webp' });
		return { src: built.src, width, height };
	})
);
---

<dialog class="lb" id={id} data-lightbox aria-label={`${name} screenshots`}>
	<div class="lb__shell">
		<header class="lb__bar">
			<p class="lb__title">{name}</p>
			<p class="lb__count" aria-live="polite">
				<span data-lb-current>1</span> / {frames.length}
			</p>
			<button class="lb__close" type="button" data-lb-close aria-label="Close gallery">
				<Icon name="close" size={20} />
			</button>
		</header>

		<div class="lb__stage">
			<button class="lb__nav" type="button" data-lb-step="-1" aria-label="Previous image">
				<Icon name="arrow-left" size={22} />
			</button>

			<img
				class="lb__image"
				data-lb-image
				src={frames[0]?.src}
				width={frames[0]?.width}
				height={frames[0]?.height}
				alt={`${name} screenshot 1`}
				data-lb-alt-prefix={`${name} screenshot`}
			/>

			<button class="lb__nav" type="button" data-lb-step="1" aria-label="Next image">
				<Icon name="arrow-right" size={22} />
			</button>
		</div>

		{/* Every frame reachable in one click; also the preload source for the
		    stage, which reads src/width/height straight off these buttons. */}
		<ul class="lb__strip">
			{
				images.map((img, i) => (
					<li>
						<button
							class="lb__chip"
							type="button"
							data-lb-go={i}
							data-src={frames[i].src}
							data-w={frames[i].width}
							data-h={frames[i].height}
							aria-label={`Show ${name} screenshot ${i + 1}`}
						>
							<Image src={img} alt="" widths={[88, 176]} sizes="88px" loading="lazy" />
						</button>
					</li>
				))
			}
		</ul>
	</div>
</dialog>

<style>
	/* ::backdrop and the top layer mean this never has to fight the sticky,
	   scroll-driven project cards for stacking order. */
	.lb {
		width: min(1180px, 94vw);
		max-height: 92vh;
		padding: 0;
		border: 0;
		border-radius: 22px;
		background: var(--c-dark);
		color: var(--c-ink-invert);
		overflow: hidden;
	}

	.lb::backdrop {
		background: rgba(0, 0, 0, 0.82);
		backdrop-filter: blur(6px);
	}

	.lb[open] {
		animation: lb-in var(--dur) var(--ease-out);
	}

	@keyframes lb-in {
		from {
			opacity: 0;
			transform: translate3d(0, 12px, 0) scale(0.985);
		}
	}

	.lb__shell {
		display: flex;
		flex-direction: column;
		max-height: 92vh;
	}

	.lb__bar {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 16px 16px 12px 22px;
	}

	.lb__title {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.lb__count {
		margin-left: auto;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		opacity: 0.6;
	}

	.lb__close,
	.lb__nav {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1px solid rgba(242, 242, 247, 0.16);
		background: rgba(242, 242, 247, 0.06);
		color: inherit;
		flex: none;
		transition:
			background var(--dur-fast) ease,
			border-color var(--dur-fast) ease,
			transform var(--dur-fast) var(--ease-spring);
	}

	.lb__close:hover,
	.lb__nav:hover {
		background: var(--c-accent);
		border-color: var(--c-accent);
		transform: scale(1.06);
	}

	.lb__stage {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 0 16px;
		min-height: 0;
	}

	.lb__image {
		flex: 1 1 auto;
		min-width: 0;
		max-height: 62vh;
		width: 100%;
		height: auto;
		object-fit: contain;
		border-radius: 14px;
		background: rgba(0, 0, 0, 0.35);
	}

	.lb__strip {
		display: flex;
		gap: 8px;
		padding: 16px;
		overflow-x: auto;
		scrollbar-width: thin;
	}

	.lb__chip {
		display: block;
		width: 88px;
		aspect-ratio: 16 / 10;
		border-radius: 9px;
		overflow: hidden;
		border: 1px solid transparent;
		opacity: 0.5;
		flex: none;
		transition:
			opacity var(--dur-fast) ease,
			border-color var(--dur-fast) ease;
	}

	.lb__chip :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.lb__chip:hover {
		opacity: 0.85;
	}

	.lb__chip[aria-current='true'] {
		opacity: 1;
		border-color: var(--c-accent);
	}

	@media (max-width: 700px) {
		.lb__nav {
			display: none;
		}

		.lb__image {
			max-height: 54vh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lb[open] {
			animation: none;
		}

		.lb__close,
		.lb__nav,
		.lb__chip {
			transition: none;
		}

		.lb__close:hover,
		.lb__nav:hover {
			transform: none;
		}
	}
</style>

<script>
	type Frame = { src: string; width: number; height: number };

	document.querySelectorAll<HTMLDialogElement>('[data-lightbox]').forEach((dialog) => {
		const image = dialog.querySelector<HTMLImageElement>('[data-lb-image]');
		const current = dialog.querySelector<HTMLElement>('[data-lb-current]');
		const chips = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-lb-go]'));
		if (!image || !chips.length) return;

		const prefix = image.dataset.lbAltPrefix ?? 'Screenshot';
		const frames: Frame[] = chips.map((chip) => ({
			src: chip.dataset.src ?? '',
			width: Number(chip.dataset.w ?? 0),
			height: Number(chip.dataset.h ?? 0),
		}));

		let index = 0;

		const show = (next: number) => {
			/* Wrap, so the arrows never dead-end. */
			index = (next + frames.length) % frames.length;
			const frame = frames[index];

			image.src = frame.src;
			image.width = frame.width;
			image.height = frame.height;
			image.alt = `${prefix} ${index + 1}`;
			if (current) current.textContent = String(index + 1);

			chips.forEach((chip, i) => chip.setAttribute('aria-current', String(i === index)));
			chips[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
		};

		const open = (at: number) => {
			show(at);
			dialog.showModal();
			/* <dialog> stops its own scrolling but not the page behind it, and
			   the project stack is scroll-driven — so lock the body too. */
			document.body.style.overflow = 'hidden';
		};

		dialog.addEventListener('close', () => {
			document.body.style.overflow = '';
		});

		/* Clicking the backdrop lands on the dialog itself, never a child. */
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());

		dialog.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((button) => {
			button.addEventListener('click', () => show(index + Number(button.dataset.lbStep)));
		});

		chips.forEach((chip, i) => chip.addEventListener('click', () => show(i)));

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				show(index + 1);
			} else if (event.key === 'ArrowLeft') {
				event.preventDefault();
				show(index - 1);
			}
		});

		document.querySelectorAll<HTMLElement>(`[data-lb-open="${dialog.id}"]`).forEach((trigger) => {
			trigger.addEventListener('click', () => open(Number(trigger.dataset.lbIndex ?? 0)));
		});
	});
</script>
